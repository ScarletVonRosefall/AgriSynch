rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products: allow reads by anyone, allow stock updates (increase/decrease) for authenticated users
    match /products/{productId} {
      allow read: if true;

      // Dev-only: allow authenticated users to update stock, isAvailable, and updatedAt
      // This is permissive for testing order cancel + stock restore flow
      allow update: if request.auth != null;
    }

    // Orders: allow read/write for buyer and farmer and admins
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.buyerId
            || request.auth.uid == resource.data.farmerId
            || request.auth.token.admin == true);

      // Allow buyer to update their own order (for cancel)
      allow update: if request.auth != null
        && request.auth.uid == resource.data.buyerId;
    }

    // Default: allow all authenticated reads/writes (dev-only, temporary)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
