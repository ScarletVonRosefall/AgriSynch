rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Validate string field is not empty and within length limit
    function isValidString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }
    
    // Validate number is positive
    function isPositiveNumber(value) {
      return value is number && value > 0;
    }
    
    // Validate price (positive and reasonable)
    function isValidPrice(price) {
      return price is number && price > 0 && price <= 1000000;
    }
    
    // Validate quantity (positive integer)
    function isValidQuantity(qty) {
      return qty is int && qty > 0 && qty <= 100000;
    }
    
    // Validate stock (can be 0 or positive)
    function isValidStock(stock) {
      return stock is int && stock >= 0 && stock <= 100000;
    }
    
    // Validate order status
    function isValidOrderStatus(status) {
      return status in ['pending', 'confirmed', 'preparing', 'delivering', 'delivered', 'cancelled'];
    }
    
    // Check if user is admin
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // ==================== PRODUCTS COLLECTION ====================
    
    match /products/{productId} {
      // Anyone authenticated can browse products
      allow read: if isSignedIn();
      
      // Only farmers can create products with their own farmerId
      allow create: if isSignedIn() 
        && request.resource.data.farmerId == request.auth.uid
        && isValidString(request.resource.data.name, 100)
        && isValidString(request.resource.data.category, 50)
        && isValidPrice(request.resource.data.price)
        && isValidQuantity(request.resource.data.stock)
        && isValidString(request.resource.data.unit, 20)
        && request.resource.data.isAvailable is bool
        && request.resource.data.createdAt is timestamp;
      
      // Only the farmer who created can update their product
      // OR buyers can update ONLY the stock field (when placing orders)
      // OR admins can update any product
      allow update: if isSignedIn() && (
        // Farmer updating their own product
        (resource.data.farmerId == request.auth.uid
          && request.resource.data.farmerId == request.auth.uid // Prevent farmerId change
          && isValidString(request.resource.data.name, 100)
          && isValidPrice(request.resource.data.price)
          && isValidQuantity(request.resource.data.stock)
          && request.resource.data.isAvailable is bool)
        ||
        // Buyer decrementing stock when placing order (SIMPLIFIED FOR TESTING)
        // Allow any authenticated user to decrease stock
        (request.resource.data.stock <= resource.data.stock 
          && request.resource.data.stock >= 0)
        ||
        // Admin can update any product
        isAdmin()
      );
      
      // Only the farmer who created can delete their product OR admins can delete any product
      allow delete: if isSignedIn() && (
        resource.data.farmerId == request.auth.uid
        || isAdmin()
      );
    }
    
    // ==================== ORDERS COLLECTION ====================
    
    match /orders/{orderId} {
      // Buyers create orders - simplified validation
      allow create: if isSignedIn() 
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && isPositiveNumber(request.resource.data.totalAmount)
        && request.resource.data.orderDate is timestamp;
      
      // Both buyer and farmer can read their orders, OR admins can read all orders
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
      
      // Only farmers can update order status (not buyer or total amount)
      allow update: if isSignedIn() 
        && resource.data.farmerId == request.auth.uid
        && request.resource.data.buyerId == resource.data.buyerId // Prevent buyer change
        && request.resource.data.farmerId == resource.data.farmerId // Prevent farmer change
        && request.resource.data.totalAmount == resource.data.totalAmount // Prevent price change
        && isValidOrderStatus(request.resource.data.status);
      
      // Only buyers can cancel pending orders OR admins can delete any order
      allow delete: if isSignedIn() && (
        (resource.data.buyerId == request.auth.uid && resource.data.status == 'pending')
        || isAdmin()
      );
    }
    
    // ==================== USERS COLLECTION ====================
    
    match /users/{userId} {
      // Allow all authenticated users to read all user profiles (for messaging/browsing)
      allow read: if isSignedIn();
      
      // Users can create their own profile
      allow create: if isOwner(userId);
      
      // Users can update their own profile, OR anyone can update rating fields, OR admins can update ban status
      allow update: if isOwner(userId) 
        || (isSignedIn() 
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'reviewCount']))
        || isAdmin();
      
      // Users can delete their own profile OR admins can delete any user
      allow delete: if isOwner(userId) 
        || isAdmin();
      
      // ========== TASKS SUBCOLLECTION ==========
      match /tasks/{taskId} {
        allow create: if isOwner(userId)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && isValidString(request.resource.data.title, 200)
          && isValidString(request.resource.data.description, 1000)
          && request.resource.data.dueDate is timestamp
          && request.resource.data.priority in ['Low', 'Medium', 'High', 'Urgent']
          && request.resource.data.completed is bool;
        
        allow read: if isOwner(userId);
        
        allow update: if isOwner(userId)
          && request.resource.data.updatedAt is timestamp
          && isValidString(request.resource.data.title, 200)
          && request.resource.data.completed is bool;
          
        allow delete: if isOwner(userId);
      }
      
      // ========== TRANSACTIONS SUBCOLLECTION (FINANCES) ==========
      match /transactions/{transactionId} {
        allow create: if isOwner(userId)
          && request.resource.data.type in ['income', 'expense']
          && isValidString(request.resource.data.category, 50)
          && isPositiveNumber(request.resource.data.amount)
          && request.resource.data.amount <= 10000000 // Max transaction amount
          && isValidString(request.resource.data.description, 500)
          && request.resource.data.date is string; // ISO date string
        
        allow read: if isOwner(userId);
        
        allow update: if isOwner(userId)
          && request.resource.data.type in ['income', 'expense']
          && isPositiveNumber(request.resource.data.amount)
          && request.resource.data.amount <= 10000000;
        
        allow delete: if isOwner(userId);
      }
      
      // ========== SHOPPING CART SUBCOLLECTION ==========
      match /cart/{cartId} {
        // Users can read and write their own cart
        allow read, write: if isOwner(userId);
      }
    }
    
    // ==================== CALENDAR EVENTS ====================
    
    match /calendar_events/{eventId} {
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.title, 200)
        && request.resource.data.createdAt is timestamp;
      
      allow read, update, delete: if isSignedIn() 
        && resource.data.userId == request.auth.uid;
    }
    
    // Events collection (alternative calendar location)
    match /events/{eventId} {
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.title, 200);
      
      allow read, update, delete: if isSignedIn() 
        && resource.data.userId == request.auth.uid;
    }
    
    // ==================== LEGACY COLLECTIONS ====================
    
    // Top-level transactions collection (legacy - prefer users/{userId}/transactions)
    match /transactions/{transactionId} {
      allow read, write: if isSignedIn() 
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid;
    }
    
    // ==================== PUBLIC COLLECTIONS ====================
    
    // Pre-registration collection (public write, no read)
    match /pre_users/{docId} {
      allow create: if isValidString(request.resource.data.email, 100);
      allow delete: if true; // Allow cleanup
      allow read: if false; // Keep emails private
    }
    
    // ==================== FEEDBACK COLLECTION ====================
    
    match /feedback/{feedbackId} {
      // Anyone authenticated can submit feedback
      allow create: if isSignedIn()
        && isValidString(request.resource.data.feedback, 500)
        && request.resource.data.category in ['General', 'Bug Report', 'Feature Request', 
                                               'Technical Support', 'Account Issues', 
                                               'General Question/Comment']
        && request.resource.data.timestamp is timestamp
        && request.resource.data.status == 'submitted';
      
      // Users can read their own feedback, admins can read all feedback
      allow read: if isSignedIn() 
        && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Only admins can update feedback status or add responses
      allow update: if isAdmin();
      
      // Only admins can delete feedback
      allow delete: if isAdmin();
    }
    
    // ==================== CHAT COLLECTIONS ====================
    
    // Messages collection - Simplified rules
    match /messages/{messageId} {
      // Any authenticated user can read messages
      allow read: if isSignedIn();
      
      // Users can create messages (sender must be authenticated user)
      allow create: if isSignedIn() 
        && request.resource.data.senderId == request.auth.uid;
      
      // Users can update messages if authenticated
      allow update: if isSignedIn();
      
      // Anyone can delete messages (for chat cleanup) OR admins can delete any message
      allow delete: if isSignedIn();
    }
    
    // Conversations collection - Simplified rules
    match /conversations/{conversationId} {
      // Any authenticated user can create, read, update, delete conversations
      allow read, write: if isSignedIn();
    }
    
    // ==================== REVIEWS COLLECTION ====================
    
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if isSignedIn();
      
      // Only buyers can create reviews
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && isValidString(request.resource.data.farmerId, 50)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      
      // Only the buyer who wrote the review can update it
      allow update: if isSignedIn()
        && resource.data.buyerId == request.auth.uid
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.farmerId == resource.data.farmerId
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.updatedAt is timestamp;
      
      // Only the buyer who wrote the review can delete it
      allow delete: if isSignedIn()
        && resource.data.buyerId == request.auth.uid;
    }
    
    // ==================== ADMIN COLLECTIONS ====================
    
    // Account Action Requests (Suspension & Deletion)
    match /accountActionRequests/{requestId} {
      // Users can create account action requests for themselves
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // Only admins can read and update action requests
      allow read, update, delete: if isAdmin();
    }
    
    // Legacy: Deletion Requests (kept for backwards compatibility)
    match /deletionRequests/{requestId} {
      // Users can create deletion requests for themselves
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // Only admins can read and update deletion requests
      allow read, update, delete: if isAdmin();
    }
    
    // Reports (Content Flagging)
    match /reports/{reportId} {
      // Users can create reports
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
      
      // Only admins can read, update, and delete reports
      allow read, update, delete: if isAdmin();
    }
    
    // Bans/Suspensions Log
    match /bans/{banId} {
      // Only admins can create and read ban records
      allow create, read: if isAdmin();
    }
    
    // Notifications
    match /notifications/{notificationId} {
      // Users can read their own notifications OR admins can read all
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can update their own notifications (mark as read) OR admins can update any
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Admins can create notifications for anyone
      allow create: if isAdmin();
      
      // Users can delete their own notifications OR admins can delete any
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // ==================== RATE LIMITS COLLECTION ====================
    
    match /rateLimits/{rateLimitId} {
      // Users can read their own rate limit records
      allow read: if isSignedIn() && rateLimitId.matches(request.auth.uid + '_.*');
      
      // Users can create and update their own rate limit records
      allow create, update: if isSignedIn() && rateLimitId.matches(request.auth.uid + '_.*');
      
      // Admins can read all rate limit records
      allow read: if isAdmin();
      
      // Admins can delete any rate limit record (for reset functionality)
      allow delete: if isAdmin();
    }
  }
}
